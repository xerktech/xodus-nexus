@@ -0,0 +1,40 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later
+ * Endpoint host matching, kept free of other xgameruntime state so the
+ * token-dispatch probe can test the code the runtime ships. */
+#ifndef XUSER_ENDPOINT_MATCH_H
+#define XUSER_ENDPOINT_MATCH_H
+
+/* Glob match of an endpoint host pattern ('*' any run, '?' any one character)
+ * with backtracking to the most recent '*'. A trailing '*' must still match
+ * once the input is exhausted, so a title's catch-all "*" entry matches every
+ * host as it does on Windows. Hosts compare case-insensitively, like the exact
+ * entries in user_GetEndpointInfo. */
+static BOOLEAN match_wildcard( const WCHAR *pat, UINT32 patLen, const WCHAR *inp, UINT32 inpLen )
+{
+    UINT32 lastMatch = 0, lastWildcard = ~0u, patOff = 0, inpOff = 0;
+
+    while (inpOff < inpLen)
+    {
+        if (patOff < patLen && pat[patOff] == '*')
+        {
+            lastWildcard = patOff++;
+            lastMatch = inpOff;
+        }
+        else if (patOff < patLen && (pat[patOff] == '?' || !wcsnicmp( pat + patOff, inp + inpOff, 1 )))
+        {
+            patOff++;
+            inpOff++;
+        }
+        else if (lastWildcard != ~0u)
+        {
+            patOff = lastWildcard + 1;
+            inpOff = ++lastMatch;
+        }
+        else return FALSE;
+    }
+
+    while (patOff < patLen && pat[patOff] == '*') patOff++;
+    return patOff == patLen;
+}
+
+#endif
