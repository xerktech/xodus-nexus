 const LAUNCH_STUB_SUFFIX: &str = ".xodus-launch.exe";
+const LAUNCH_VIEW_PREFIXES: [&str; 2] = [".xodus-chain-", ".xodus-offline-"];
+const LAUNCH_VIEW_LOCK_SUFFIX: &str = ".lock";
+// Views from builds before the lock file have no way to say they are in use;
+// only remove those once nothing can plausibly still be running from them.
+const UNLOCKED_LAUNCH_VIEW_MAX_AGE: std::time::Duration = std::time::Duration::from_secs(24 * 60 * 60);
+
+/// A temporary launch view plus the lock that marks it in use. A session that
+/// dies without dropping this leaves the view behind; the kernel releases the
+/// lock, so the next launch's sweep can tell the view is stale.
+struct LaunchView {
+    dir: TempDir,
+    _lock: Option<LaunchViewLock>,
+}
+
+impl LaunchView {
+    fn new(dir: TempDir) -> Self {
+        // Without a lock the view is only swept once it is old, so a volume
+        // that cannot take locks still launches.
+        let lock = LaunchViewLock::acquire(&launch_view_lock_path(dir.path()))
+            .inspect_err(|error| eprintln!("could not lock launch view {}: {}", dir.path().display(), error))
+            .ok();
+        Self { dir, _lock: lock }
+    }
+
+    fn path(&self) -> &Path {
+        self.dir.path()
+    }
+}
+
+struct LaunchViewLock {
+    path: PathBuf,
+    _file: std::fs::File,
+}
+
+impl LaunchViewLock {
+    fn acquire(path: &Path) -> std::io::Result<Self> {
+        // Lock under a private name, then rename into place, so a sweep never
+        // finds the final lock file unlocked while its view is live.
+        let staging = tempfile::NamedTempFile::new_in(path.parent().unwrap_or(Path::new(".")))?;
+        fs2::FileExt::try_lock_exclusive(staging.as_file())?;
+        let file = staging.persist(path).map_err(|error| error.error)?;
+        Ok(Self { path: path.to_path_buf(), _file: file })
+    }
+}
+
+impl Drop for LaunchViewLock {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_file(&self.path);
+    }
+}
+
+fn launch_view_lock_path(view: &Path) -> PathBuf {
+    let mut name = view.as_os_str().to_os_string();
+    name.push(LAUNCH_VIEW_LOCK_SUFFIX);
+    PathBuf::from(name)
+}
+
+/// Remove launch views in `parent` left by sessions that ended without
+/// cleaning up. A view whose lock another process holds is in use and kept.
+fn sweep_stale_launch_views(parent: &Path) -> usize {
+    let Ok(entries) = std::fs::read_dir(parent) else { return 0 };
+    let mut removed = 0;
+    for entry in entries.flatten() {
+        let name = entry.file_name();
+        let Some(name) = name.to_str() else { continue };
+        if !LAUNCH_VIEW_PREFIXES.iter().any(|prefix| name.starts_with(prefix)) {
+            continue;
+        }
+        let path = entry.path();
+        if let Some(view) = name.strip_suffix(LAUNCH_VIEW_LOCK_SUFFIX) {
+            // A lock whose view is already gone: drop it once nobody holds it.
+            let view = parent.join(view);
+            if std::fs::symlink_metadata(&view).is_err() {
+                if let Ok(file) = std::fs::File::open(&path) {
+                    if fs2::FileExt::try_lock_exclusive(&file).is_ok() {
+                        let _ = std::fs::remove_file(&path);
+                    }
+                }
+            }
+            continue;
+        }
+        let Ok(metadata) = std::fs::symlink_metadata(&path) else { continue };
+        if !metadata.is_dir() {
+            continue;
+        }
+        let lock_path = launch_view_lock_path(&path);
+        let stale = match std::fs::File::open(&lock_path) {
+            Ok(file) => {
+                if fs2::FileExt::try_lock_exclusive(&file).is_err() {
+                    continue;
+                }
+                let stale = std::fs::remove_dir_all(&path).is_ok();
+                let _ = std::fs::remove_file(&lock_path);
+                stale
+            }
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {
+                let old = metadata
+                    .modified()
+                    .ok()
+                    .and_then(|modified| modified.elapsed().ok())
+                    .is_some_and(|age| age > UNLOCKED_LAUNCH_VIEW_MAX_AGE);
+                old && std::fs::remove_dir_all(&path).is_ok()
+            }
+            Err(_) => false,
+        };
+        if stale {
+            removed += 1;
+        }
+    }
+    removed
+}
+
+fn create_launch_view_dir(parent: &Path, prefix: &str) -> std::io::Result<LaunchView> {
+    let removed = sweep_stale_launch_views(parent);
+    if removed > 0 {
+        eprintln!("removed {} stale launch views from {}", removed, parent.display());
+    }
+    let dir = Builder::new()
+        .prefix(prefix)
+        .tempdir_in(parent)
+        .or_else(|_| Builder::new().prefix(prefix.trim_start_matches('.')).tempdir())?;
+    Ok(LaunchView::new(dir))
+}
 
