+/* Like native XTaskQueueSuspendTermination, each XAsync operation defers its
+ * queue's termination until it has signaled completion. A terminated queue
+ * starts no new operations. */
+static HRESULT queue_suspend_termination( XTaskQueueHandle queue )
+{
+    HRESULT hr = S_OK;
+    EnterCriticalSection( &queue->cs );
+    if (queue->terminated) hr = E_ABORT;
+    else ++queue->suspended;
+    LeaveCriticalSection( &queue->cs );
+    return hr;
+}
+
+static void queue_resume_termination( XTaskQueueHandle queue )
+{
+    EnterCriticalSection( &queue->cs );
+    --queue->suspended;
+    LeaveCriticalSection( &queue->cs );
+    queue_maybe_finish( queue );
+}
